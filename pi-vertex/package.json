{
  "name": "@ssweens/pi-vertex",
  "version": "1.2.5",
  "description": "Google Vertex AI provider for Pi coding agent - supports Gemini, Claude, and all MaaS models",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "auth.ts",
    "config.ts",
    "types.ts",
    "utils.ts",
    "models/",
    "streaming/",
    "README.md",
    "CHANGELOG.md",
    "TEST_COVERAGE.md",
    "LICENSE",
    "screenshot.png",
    "tests/"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "echo 'nothing to check'",
    "test": "node --experimental-strip-types --test tests/*.mjs"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.14.4",
    "@google/genai": "^2.22.0",
    "google-auth-library": "^9.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.1 <0.100.0",
    "@earendil-works/pi-coding-agent": ">=0.99.1 <0.100.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "vertex-ai",
    "gemini",
    "claude",
    "maas"
  ],
  "author": "ssweens",
  "license": "MIT"
}
